# Replace observe.example.org and certificate paths before installing.
server {
    listen 80;
    server_name observe.example.org;
    return 301 https://observe.example.org$request_uri;
}
server {
    listen 443 ssl;
    server_name observe.example.org;
    ssl_certificate /etc/letsencrypt/live/observe.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/observe.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    location / {
        proxy_pass http://127.0.0.1:9420;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }
}
