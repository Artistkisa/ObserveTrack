[Unit]
Description=ObserveTrack collector and report worker
After=network-online.target
Wants=network-online.target

[Service]
User=observetrack
Group=observetrack
WorkingDirectory=/opt/observetrack
EnvironmentFile=/etc/observetrack.env
ExecStart=/opt/observetrack/.venv/bin/python -m observetrack.worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
MemoryMax=512M
CPUWeight=25
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/observetrack

[Install]
WantedBy=multi-user.target
