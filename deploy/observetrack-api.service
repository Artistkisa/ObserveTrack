[Unit]
Description=ObserveTrack private API
After=network-online.target
Wants=network-online.target

[Service]
User=observetrack
Group=observetrack
WorkingDirectory=/opt/observetrack
EnvironmentFile=/etc/observetrack.env
ExecStart=/opt/observetrack/.venv/bin/uvicorn observetrack.app:app --host 127.0.0.1 --port 9420 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
MemoryMax=256M
CPUWeight=25
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/observetrack

[Install]
WantedBy=multi-user.target
