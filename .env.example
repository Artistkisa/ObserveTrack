# Environment variables override this file. Never commit .env.
OBSERVE_DATA=data
OBSERVE_ADMIN_PASSWORD=
OBSERVE_GITHUB_TOKEN=
# Base URL must include the API version path when required (e.g. /v1).
OBSERVE_MODEL_BASE_URL=
OBSERVE_MODEL_NAME=
OBSERVE_MODEL_API_KEY=
# Local HTTP only. Set true when deployed behind HTTPS.
OBSERVE_SECURE_COOKIE=false
OBSERVE_ANALYSIS_V2=false
OBSERVE_ANALYSIS_V2_REPOSITORIES=
